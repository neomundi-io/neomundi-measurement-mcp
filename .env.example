# PROPOSITION NON ACTIVE : aucun serveur ni chargement dotenv implementes.
# Valeurs volontairement vides. Ne pas inserer de secret dans ce fichier.
NEOMUNDI_API_BASE_URL=
NEOMUNDI_API_KEY=
NEOMUNDI_MCP_API_KEY=
# Seulement si la generation SSE est retenue :
NEOMUNDI_PROVIDER_API_KEY=
# Seulement pour un hebergement derriere un proxy TLS : en-tetes Host acceptes
# en plus de la paire loopback, separes par des virgules. Vide par defaut.
NEOMUNDI_MCP_ALLOWED_HOSTS=

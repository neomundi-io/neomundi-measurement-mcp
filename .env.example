# PROPOSITION NON ACTIVE : aucun serveur ni chargement dotenv implementes.
# Valeurs volontairement vides. Ne pas inserer de secret dans ce fichier.
NEOMUNDI_API_BASE_URL=
NEOMUNDI_API_KEY=
NEOMUNDI_MCP_API_KEY=
# Seulement si la generation SSE est retenue :
NEOMUNDI_PROVIDER_API_KEY=
# Seulement pour un hebergement derriere un proxy TLS : en-tetes Host acceptes
# en plus de la paire loopback, separes par des virgules. Vide par defaut.
NEOMUNDI_MCP_ALLOWED_HOSTS=

# --- OAuth 2.1 (optionnel) -------------------------------------------------
# Les TROIS variables ci-dessous vont ensemble : aucune, ou les trois. Une
# configuration partielle est refusee au demarrage plutot qu a moitie activee.
# Laissees vides, le serveur se comporte EXACTEMENT comme avant et la cle
# statique reste le seul acces.
#
# ATTENTION : NEOMUNDI_API_KEY est la cle TECHNIQUE qui appelle l instrument.
# Elle n a rien a voir avec l identite des utilisateurs ci-dessous, et les
# deux ne doivent jamais etre confondues ni partagees.
NEOMUNDI_MCP_PUBLIC_URL=
# >= 32 octets. A generer avec: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# La changer invalide TOUS les jetons et TOUTES les inscriptions de clients.
NEOMUNDI_OAUTH_SIGNING_KEY=
# Chemin du registre des participants, monte en LECTURE SEULE. Jamais ecrit.
# Entrees produites par: node scripts/participant-credential.mjs <sujet>
NEOMUNDI_OAUTH_REGISTRY=
# Optionnels.
NEOMUNDI_OAUTH_ACCESS_TTL_S=
NEOMUNDI_OAUTH_REFRESH_TTL_S=
# Laisse vide, RIEN n est compte et rien n est retenu entre deux requetes.
# Le renseigner fait tenir un compteur par participant EN MEMOIRE : verifier
# d abord que la politique de confidentialite publiee le decrit.
NEOMUNDI_OAUTH_QUOTA_PER_SUBJECT=

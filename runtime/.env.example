# Documentation only: this server does not load .env files.
# Provision existing credentials through your secure process environment.
# Never put an actual secret in this example.
NEOMUNDI_API_KEY=
NEOMUNDI_MCP_API_KEY=
# Optional, required only for generation/SSE:
NEOMUNDI_PROVIDER_API_KEY=
# Optional non-secret settings; these are the defaults:
NEOMUNDI_API_BASE_URL=https://api.neomundi.io
NEOMUNDI_MCP_PORT=8787
NEOMUNDI_TIMEOUT_MS=120000
NEOMUNDI_IDLE_TIMEOUT_MS=30000
NEOMUNDI_MAX_RESPONSE_BYTES=2097152
# Optional. Host headers accepted in addition to the loopback pair, comma-separated.
# Empty by default; required only when hosting behind a TLS-terminating proxy.
# Exact match, lowercase, host or host:port. No wildcard. Independent of NEOMUNDI_MCP_BIND.
NEOMUNDI_MCP_ALLOWED_HOSTS=

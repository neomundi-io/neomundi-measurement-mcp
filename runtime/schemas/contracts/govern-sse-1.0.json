    "cost",
    "stream_interrupted",
    "response_text",
    "response_length",
    "response_bytes",
    "response_sha256",
    "counter_units",
    "is_long_form_safe",
    "delta_g",
    "measured_signals",
    "unmeasured_signals",
    "checks_emitted",
    "trajectory_points",
    "evaluators",
    "measurement",
